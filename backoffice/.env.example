# BackOffice Portal —— 环境变量模板（复制为 .env.local，文件不入库）

# PostgreSQL 连接串
DATABASE_URL=postgresql://admin:admin@127.0.0.1:5432/learning_guide_db

# 会话令牌签名密钥：>= 32 字符
SESSION_SECRET=

# DEV | SIT | UAT | PPE | PROD
APP_ENV=DEV

# 站点根地址，用于邮件里的激活 / 重置链接
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Bootstrap Admin 初始化（一次性，执行后可移除）
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------- 邮件投递
# 与 LearningGuidePortal services/emailService.ts 的取值保持一致：
#   1) SMTP_* 齐全 → 走 SMTP（线上使用 163 SMTP：smtp.163.com:465，发件人 learningguide@163.com）
#   2) 只配 SES_FROM_EMAIL → 走 AWS SESv2（默认区域 ap-southeast-1，由实例角色授权）
#   3) 都不配 → DEV 环境把邮件内容打到服务端日志；其它环境返回 NOT_CONFIGURED，不会伪装成功
SMTP_HOST=
SMTP_PORT=465
# 置 0 可关闭 TLS（仅本地自建邮件服务器需要）
SMTP_SECURE=1
SMTP_USER=
# 163 等邮箱的授权码，不要写进 Git
SMTP_PASS=
# 发件地址；留空时依次回退 SES_FROM_EMAIL、SMTP_USER
SMTP_FROM=

# SES 备用通道
SES_FROM_EMAIL=
AWS_REGION=ap-southeast-1

# 可选：discard（只丢弃并报成功）/ fail（强制失败），用于联调
EMAIL_DELIVERY=
