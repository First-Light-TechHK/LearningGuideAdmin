# BackOffice Portal —— 环境变量模板（复制为 .env.local，文件不入库）

# PostgreSQL 连接串
DATABASE_URL=postgresql://admin:admin@127.0.0.1:5432/learning_guide_db

# 会话令牌签名密钥，>= 32 字符
SESSION_SECRET=

# DEV | SIT | UAT | PPE | PROD
APP_ENV=DEV

# 站点根地址，用于邮件里的激活/重置链接
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Bootstrap Admin 初始化（一次性，执行后可移除）
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 邮件投递：留空时使用 console adapter（开发态把链接打到服务端日志）
SES_FROM_EMAIL=
