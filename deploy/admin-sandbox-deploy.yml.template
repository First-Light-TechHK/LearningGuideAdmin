# =============================================================================
# 模板：Admin Sandbox 部署工作流
# 复制到 LearningGuideAdmin 仓库的 .github/workflows/sandbox-deploy.yml 使用。
# 由上游 .github/workflows/dev-deploy.yml 改编。2026-11-19 从 LearningGuideSandbox
# 仓库合并进 Admin 仓库 deploy/（内容全部落在 Admin 仓库）。
# 前置：
#   - ops 已创建 learning-guide-admin-sandbox 服务并填入仓库变量
#     ADMIN_SANDBOX_APP_RUNNER_SERVICE_ARN（scripts/provision-admin-dev.mjs
#     以 ADMIN_ENV=sandbox 创建，或手工创建均可）。
#   - 仓库 secrets AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 对应专用 IAM 用户
#     （策略模板见本仓库 deploy/ci-iam-policy.json.template）。
#   - **发布门禁**：本工作流只在 push 到 `sandbox` 分支时触发（或手动触发）；
#     `sandbox` 分支只允许快进到上游最近一次生产发布（UAT=当前生产）的 SHA
#     （禁止 sandbox 专属提交与 dev/feature 分支直接部署）。修复合入上游 dev 后，
#     随下一次生产发布进入 sandbox。契约见 docs/sandbox/partitioning.md §6。
#   - provision 脚本对 sandbox 关闭了 App Runner 分支自动部署
#     （AutoDeploymentsEnabled=false），本工作流是唯一发布者：先等 CI 通过，
#     再 start-deployment 并轮询到 SUCCEEDED。
#   - 能力分区：沙箱首期不启用 AI Tutor——SANDBOX_OPENROUTER_API_KEY_SECRET_ARN /
#     SANDBOX_AI_CONFIG_ENCRYPTION_KEY_SECRET_ARN 保持未设置，下面的 AI 步骤自动跳过。
# =============================================================================
name: Deploy Sandbox

on:
  push:
    branches: [sandbox]
  workflow_dispatch:

concurrency:
  group: admin-sandbox-deploy
  cancel-in-progress: false

permissions:
  contents: read
  actions: read

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Require the Sandbox service ARN
        env:
          ARN: ${{ vars.ADMIN_SANDBOX_APP_RUNNER_SERVICE_ARN }}
        run: |
          if [ -z "$ARN" ]; then
            echo "::error::ADMIN_SANDBOX_APP_RUNNER_SERVICE_ARN is not set. Provision the Sandbox App Runner service first."
            exit 1
          fi

      - name: Wait for CI to pass on this commit
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
        run: |
          set -u
          for _ in $(seq 1 90); do
            conclusion="$(gh api "repos/$REPO/actions/runs?head_sha=$GITHUB_SHA&per_page=30" \
              --jq '.workflow_runs[] | select(.name == "CI") | .conclusion' 2>/dev/null | head -1)"
            case "${conclusion:-}" in
              success) echo "CI passed for $GITHUB_SHA"; exit 0 ;;
              failure|cancelled|timed_out|action_required)
                echo "::error::CI on $GITHUB_SHA ended as $conclusion"
                exit 1
                ;;
            esac
            echo "CI not finished yet (${conclusion:-running}); waiting"
            sleep 20
          done
          echo "::error::timed out waiting for CI on $GITHUB_SHA"
          exit 1

      - uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ap-southeast-1

      # 与 dev-deploy.yml 相同的语义：密钥值只留在 Secrets Manager，仓库变量只放 ARN。
      # 沙箱首期 AI 不启用：两个 ARN 变量都不设时本步骤跳过。
      - name: Ensure AI Tutor runtime secrets
        if: vars.SANDBOX_OPENROUTER_API_KEY_SECRET_ARN != '' || vars.SANDBOX_AI_CONFIG_ENCRYPTION_KEY_SECRET_ARN != ''
        env:
          APP_RUNNER_SERVICE_ARN: ${{ vars.ADMIN_SANDBOX_APP_RUNNER_SERVICE_ARN }}
          OPENROUTER_API_KEY_SECRET_ARN: ${{ vars.SANDBOX_OPENROUTER_API_KEY_SECRET_ARN }}
          AI_CONFIG_ENCRYPTION_KEY_SECRET_ARN: ${{ vars.SANDBOX_AI_CONFIG_ENCRYPTION_KEY_SECRET_ARN }}
          AI_AVAILABLE_MODELS: ${{ vars.AI_AVAILABLE_MODELS }}
        run: node scripts/configure-admin-dev-env.mjs

      - name: Start App Runner deployment and wait for the result
        env:
          ARN: ${{ vars.ADMIN_SANDBOX_APP_RUNNER_SERVICE_ARN }}
        run: |
          set -u
          for _ in $(seq 1 80); do
            svc_status="$(aws apprunner describe-service --service-arn "$ARN" --query 'Service.Status' --output text)"
            [ "$svc_status" = "RUNNING" ] && break
            echo "service ${svc_status}; waiting for RUNNING"
            sleep 15
          done

          op=""
          for _ in $(seq 1 10); do
            if out="$(aws apprunner start-deployment --service-arn "$ARN" --output json 2>&1)"; then
              printf '%s\n' "$out"
              op="$(printf '%s\n' "$out" | jq -r '.OperationId // empty')"
              [ -n "$op" ] && break
            else
              printf '%s\n' "$out"
              case "$out" in
                *InvalidRequestException*|*"isn't in RUNNING state"*) sleep 20 ;;
                *) echo "::error::start-deployment failed"; exit 1 ;;
              esac
            fi
          done
          if [ -z "$op" ]; then
            echo "::error::start-deployment returned no OperationId"
            exit 1
          fi

          deadline=$((SECONDS + 1800))
          while [ "$SECONDS" -lt "$deadline" ]; do
            status="$(aws apprunner list-operations \
              --service-arn "$ARN" \
              --query "OperationSummaryList[?Id=='${op}'].Status | [0]" \
              --output text)"
            echo "deployment ${op} status=${status:-unknown}"
            case "$status" in
              SUCCEEDED) exit 0 ;;
              FAILED|ROLLBACK_SUCCEEDED|ROLLBACK_FAILED)
                echo "::error::App Runner deployment ${op} ended as ${status}"
                exit 1
                ;;
            esac
            sleep 20
          done
          echo "::error::timed out waiting for deployment ${op}"
          exit 1
