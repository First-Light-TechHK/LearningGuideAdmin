# =============================================================================
# Sandbox 环境变量占位模板（只放变量名与说明；无任何真实值）
#
# 参考：server/.env.example、scripts/provision-admin-dev.mjs、
#       LearningGuidePortal/.env.example、scripts/provision-uat.mjs
#
# 部署约定：
#   - 普通值 → App Runner RuntimeEnvironmentVariables
#   - 标 [secret] 的项 → RuntimeEnvironmentSecrets（值为 Secrets Manager ARN）
#   - 真实值只进 AWS Secrets Manager；仓库、GitHub、日志、工单均不得出现
#   - 详细申请/验收见 docs/sandbox/provisioning-request.md
#
# 能力分区（owner 2026-11-16 拍板、2026-11-20 修订，详见 docs/sandbox/partitioning.md）：
#   - Sandbox 的 Admin 只开放课程管理（列表/导入/解析/预览/发布/导出）与后台账号管理，
#     由 ADMIN_CAPABILITIES=course,accounts 在服务端与前端同时裁剪；**不新增编辑能力**。
#     accounts 只覆盖员工账号管理，不打开支付/通知等其它 Settings 子项。
#   - Helpdesk、学员端学生/AI Tutor（agent/ks 角色）、Study Group 等模块
#     「沙箱首期不启用」：模块被能力门隐藏并返回 404，变量也不写入本环境配置。
#   - Part C 两个强制开关（ENV_CAPABILITY_ENFORCEMENT / PACKAGE_SOURCE_ENFORCEMENT）
#     未接线，保持默认 off。
# =============================================================================


# =============================================================================
# 一、Portal（Course Sandbox 前台，Next.js，App Runner 服务 learning-guide-sandbox，:8080）
#
# 首期用途：课程内容验证（浏览/播放/订阅测试）。学员端 AI Tutor 与 Helpdesk
# 首期不启用，对应变量见第三部分。
# =============================================================================

APP_ENV=SANDBOX
NODE_ENV=production
APP_VERSION=<GIT_SHA>
PORT=8080

# --- 站点与域名 -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://<sandbox-host>
ADMIN_HOSTS=admin.<sandbox-host>

# --- 持久化（PostgreSQL + S3） ----------------------------------------------
STORAGE_BACKEND=postgresql
DATABASE_URL=<secret-ref:learning-guide/sandbox/database_url>            # [secret]
DATA_S3_BUCKET=<sandbox-portal-bucket>                                    # S3_BUCKET 不是 Portal 的变量名
DATA_S3_PREFIX=learning-guide/sandbox
AWS_REGION=ap-southeast-1
DATABASE_CA_FILE=deploy/rds-ap-southeast-1.pem

# --- 会话与注册 -------------------------------------------------------------
SESSION_SECRET=<secret-ref:learning-guide/sandbox/session_secret>        # [secret] ≥32 字符
EMAIL_VERIFICATION_REQUIRED=1
LOCAL_SOCIAL_LOGIN=0

# --- 支付（Stripe 测试模式） ------------------------------------------------
PAYMENT_MODE=stripe
STRIPE_SANDBOX=1
STRIPE_SECRET_KEY=<secret-ref:learning-guide/sandbox/stripe_secret_key>        # [secret] sk_test_…
STRIPE_WEBHOOK_SECRET=<secret-ref:learning-guide/sandbox/stripe_webhook_secret> # [secret]
STRIPE_PRICE_EVERYTHING_SIX_MONTHS=<lookup-key-or-price-id>
STRIPE_PRICE_EVERYTHING_YEAR=<lookup-key-or-price-id>
STRIPE_PRICE_CATE_EUROPEAN_HUMAN_SIX_MONTHS=<lookup-key-or-price-id>
STRIPE_PRICE_CATE_EUROPEAN_HUMAN_YEAR=<lookup-key-or-price-id>
STRIPE_PRICE_CATE_CHINESE_HUMAN_SIX_MONTHS=<lookup-key-or-price-id>
STRIPE_PRICE_CATE_CHINESE_HUMAN_YEAR=<lookup-key-or-price-id>
STRIPE_PRICE_CATE_SCIENCE_SIX_MONTHS=<lookup-key-or-price-id>
STRIPE_PRICE_CATE_SCIENCE_YEAR=<lookup-key-or-price-id>

# --- 登录提供方 -------------------------------------------------------------
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<secret-ref:learning-guide/sandbox/google_client_secret>   # [secret]
WECHAT_APP_ID=<wechat-app-id>
WECHAT_APP_SECRET=<secret-ref:learning-guide/sandbox/wechat_app_secret>         # [secret]

# --- 邮件（SMTP 优先；SES 仅回退） ------------------------------------------
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=learningguide@163.com
SMTP_PASS=<secret-ref:learning-guide/sandbox/smtp_pass>                  # [secret]
SMTP_FROM=Learning Guide <learningguide@163.com>
SES_FROM_EMAIL=learningguide@163.com

# --- Admin 目录（分类投影；课程验证所需） -----------------------------------
ADMIN_PORTAL_BASE_URL=https://<admin-sandbox-host>
ADMIN_PORTAL_API_TOKEN=<secret-ref:learning-guide/admin/sandbox/admin_api_key>  # [secret] 即 Admin AUTH_TOKEN


# =============================================================================
# 二、Admin（NestJS，App Runner 服务 learning-guide-admin-sandbox，:3000）
#
# 能力分区：只开放课程管理与导入导出。只起 admin 角色（BackOffice + 课程模块 +
# Portal 投影）；agent（学员 AI Tutor）与 ks（KS 内部接口）首期不启用。
# 注意：Admin 不使用 S3_BUCKET / S3_REGION；课程存储变量是
# COURSE_MEDIA_BUCKET / COURSE_PACKAGE_BUCKET / AWS_REGION。
# =============================================================================

APP_ENV=SANDBOX
NODE_ENV=production
PORT=3000
AWS_REGION=ap-southeast-1
APP_ROLES=admin
# 引擎角色说明（server/src/main.ts parseAppRoles）：admin = BackOffice、课程管理、
# 导入导出与 Portal 投影；不设 = 三角色全起。沙箱只起 admin。

# --- 数据库（PostgreSQL + pgvector） ---------------------------------------
DATABASE_URL=<secret-ref:learning-guide/admin/sandbox/database_url>      # [secret]
# start-admin.sh 启动时执行 npx prisma migrate deploy；
# 迁移 20261026000000_add_knowledge_chunk 会 CREATE EXTENSION vector。

# --- 服务鉴权 / 会话 --------------------------------------------------------
AUTH_ENABLED=true
AUTH_TOKEN=<secret-ref:learning-guide/admin/sandbox/admin_api_key>       # [secret]
# provision-admin-dev.mjs 创建的 secret 名为 admin_api_key，但服务端读取 AUTH_TOKEN；
# 部署时把 RuntimeEnvironmentSecrets.AUTH_TOKEN 指向该 secret ARN（脚本已映射）。
SESSION_SECRET=<secret-ref:learning-guide/admin/sandbox/session_secret> # [secret]
BOOTSTRAP_ADMIN_EMAIL=<operator-email>
BOOTSTRAP_ADMIN_PASSWORD=<secret-ref:learning-guide/admin/sandbox/bootstrap_admin_password> # [secret]
BACKOFFICE_APP_URL=https://<admin-sandbox-host>

# --- Sandbox 环境标识与版本编号（PRD §3.1 / 第 15 章） ----------------------
ENVIRONMENT_LABEL=Sandbox
VERSION_NUMBERING_MODE=sandbox
PUBLIC_SITE_URL=https://<sandbox-host>
PORTAL_PREVIEW_SECRET=<secret-ref:learning-guide/admin/sandbox/portal_preview_secret> # [secret]

# --- 模块能力门 / 预览入口 -------------------------------------------------
# 能力集未配置 = 全部启用（dev/uat/prod 行为不变）；Sandbox 开课程管理 + 账号管理。
ADMIN_CAPABILITIES=course,accounts
# 预览 = 生产投影渲染草稿（Portal 风格，单一入口）；缺省 learner 保持上游行为。
PREVIEW_ENTRY=portal

# --- 课程媒体 / 课程包存储（S3 私有桶；ops 预建，provision 脚本不自建桶） --
COURSE_MEDIA_BUCKET=<sandbox-admin-course-bucket>
COURSE_MEDIA_PREFIX=
COURSE_PACKAGE_BUCKET=<sandbox-admin-course-bucket>
COURSE_PACKAGE_PREFIX=staging/
# 课程包上限（默认值，按需覆盖）
# MEDIA_MAX_IMAGE_BYTES=20971520
# MEDIA_MAX_VIDEO_BYTES=524288000
# MEDIA_MAX_AUDIO_BYTES=104857600
# MEDIA_MAX_PDF_BYTES=104857600
# MEDIA_MAX_MODEL_BYTES=26214400
# PACKAGE_MAX_BYTES=8589934592
# PACKAGE_DIRECT_UPLOAD_BYTES=209715200
# PACKAGE_EXPORT_TTL_HOURS=24

# --- 环境能力 / 来源强制开关（默认 off；Sandbox 保持 off） ------------------
# PACKAGE_SOURCE_ENFORCEMENT：production 且 on 时，确认导入前先按 v2 契约整包
# 校验，再要求 provenance.sourceEnv=sandbox，否则 422 PACKAGE_SOURCE_NOT_ALLOWED。
# ENV_CAPABILITY_ENFORCEMENT：on 时按环境矩阵强制能力（production 禁
# course.authoring → 403 CAPABILITY_DISABLED）。
# 当前上游 dev 基线尚未包含 Part C 接线（见 docs/sandbox/environments.md §3）；
# 引入后默认仍为 off，Sandbox 保持 off
# （ENV_CAPABILITY_ENFORCEMENT 首期不设置）。
PACKAGE_SOURCE_ENFORCEMENT=off

# --- Stripe（Admin 价格同步，测试模式；课程管理的一部分） -------------------
STRIPE_SECRET_KEY=<secret-ref:learning-guide/admin/sandbox/stripe_secret_key>  # [secret] sk_test_…
STRIPE_WEBHOOK_SECRET=

# --- 邮件（可选；课程管理不依赖邮件，未配置时激活/重置链接仍由页面展示） ----
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=learningguide@163.com
# SMTP_PASS=<secret-ref:learning-guide/admin/sandbox/smtp_pass>          # [secret]
# SMTP_FROM=Learning Guide <learningguide@163.com>
# SES_FROM_EMAIL=learningguide@163.com
# EMAIL_DELIVERY=discard   # 仅联调：discard / fail


# =============================================================================
# 三、首期不启用（能力分区）：以下变量不写入 Sandbox 配置
# =============================================================================
# 代码同源；这些模块未配置时按设计降级，不影响课程管理与导入导出：
#
# - 学员端学生 / AI Tutor（Admin agent 与 ks 角色 + Portal 学员端）：
#     Admin:  OPENROUTER_API_KEY、OPENROUTER_BASE_URL、AI_CONFIG_ENCRYPTION_KEY、
#             AI_AVAILABLE_MODELS、AI_RATE_LIMIT_*
#     Portal: OPENROUTER_API_KEY、OPENROUTER_SITE_URL、OPENROUTER_APP_NAME、
#             OPENROUTER_MODEL、KS_TUTOR_BASE_URL、KS_TUTOR_API_KEY、KS_TUTOR_TIMEOUT_MS
#     沙箱 Admin 不设 agent/ks 角色（APP_ROLES=admin），/api/user/** 与 /api/ks/** 不对外。
#
# - Helpdesk 跨服务配对（Admin ↔ Portal）：
#     Portal: PORTAL_HELPDESK_TOKEN、ADMIN_HELPDESK_BASE_URL、ADMIN_HELPDESK_TOKEN
#     Admin:  PORTAL_HELPDESK_BASE_URL、PORTAL_HELPDESK_TOKEN、ADMIN_HELPDESK_TOKEN
#             （未配置时 /api/helpdesk/** 按设计返回 503 HELPDESK_NOT_CONNECTED）
#
# - Study Group / LiveKit：LIVEKIT_PROJECTS_SECRET_ID、LIVEKIT_PROJECTS_JSON、
#     LIVEKIT_LOCAL_CREDENTIALS_JSON、STUDY_GROUP_TOKEN_LOG_KEY
#
# - ENV_CAPABILITY_ENFORCEMENT：首期不设置（默认 off）。


# =============================================================================
# 四、配对一致性速查（部署前逐项打勾）
# =============================================================================
# 1. Admin AUTH_TOKEN == Portal ADMIN_PORTAL_API_TOKEN
#    （都指向 learning-guide/admin/sandbox/admin_api_key；Portal 调 Admin
#    /api/portal/v1/** 与 /api/user/** 时按 X-API-Key == AUTH_TOKEN 校验）
# 2. Admin PUBLIC_SITE_URL == Portal NEXT_PUBLIC_APP_URL（同一个 sandbox 域名）
# 3. 两服务 STRIPE_SECRET_KEY 均为 sk_test_…；Sandbox 中不得出现 sk_live_…
# 4. DATABASE_URL、S3 桶/前缀、SESSION_SECRET 各自独立，不跨环境复用
# 5. 所有 <secret-ref:…> 只以 ARN 形式进入 App Runner 配置
#
# 资源归属说明：
# - Admin 的 RDS / Secrets / App Runner 由 Admin 仓库的 provision 脚本创建
#   （ADMIN_ENV=sandbox：ADMIN_BRANCH 必传、AUTH_ENABLED=true 强制、桶名
#   -sandbox- 命名空间）；该脚本**不自建**运行时角色与课程桶：
#   INSTANCE_ROLE_ARN、COURSE_MEDIA_BUCKET / COURSE_PACKAGE_BUCKET 都是它的输入参数，
#   角色与桶需 ops 预建（deploy/sandbox-infrastructure.yml 提供 Portal 侧网络与角色，
#   Admin 侧角色/桶按 docs/sandbox/provisioning-request.md §2.2 由 ops 创建）。
