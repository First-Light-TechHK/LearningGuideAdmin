// Learning Guide BackOffice — Prisma Schema
// 依据开发文档 §2《数据库模型设计（Prisma Schema）》逐字段照抄（v1.0）
// 任何表结构变更必须通过 Prisma Migrate 管理，禁止手改数据库

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 核心实体
// ==========================================

model User {
  id      String   @id @default(uuid())
  email   String   @unique
  name    String?
  courses Course[]
}

// 第一层：课程 (Course)
model Course {
  id               String   @id @default(uuid())
  title            String
  description      String?
  externalId       String? // 对应外部同步源的 ID
  structureJson    Json? // 存储树形目录的原始结构，用于快速渲染
  // 上线版本指针（§3.4.3/§4.3.3）：用户侧 AI Tutor 读此 Release 快照；普通标量列，不建 Prisma 外键关系
  currentReleaseId String?
  // 后台「测试所选 Release」（2026-10-20 新增）：AI Tutor 后台测试对话读此 Release 快照；null 时回退 currentReleaseId
  aiTestReleaseId  String?
  // 当前编辑版本指针（2026-10-20 二次改拍）：新建 Release 或「切换到此版本」后指向该 Release；历史弹窗 editing 标识来源；普通标量列，不建 Prisma 外键关系
  editingReleaseId String?
  // 课程级 Online 开关（2026-10-20 由 CourseAiConfig.online 搬移而来）：该课程 AI Tutor 是否对用户侧开放
  aiTutorOnline    Boolean  @default(false)
  // 商品课程关联（2026-10-26 新增）：KS 课程 ↔ CommerceCourse，一个商品课程最多对应一个 KS 课程
  commerceCourseId String?  @unique
  commerceCourse   CommerceCourse? @relation(fields: [commerceCourseId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pages          Page[]
  releases       Release[]
  // 每个 Release 各一份 AI 配置（2026-10-20 由一对一改为按 Release 一对多）
  aiConfigs      CourseAiConfig[]
  // 反向关联：users 为隐式多对多，migrate 时生成联接表 _CourseToUser
  users          User[]
  aiChatSessions AiChatSession[]
}

// 第二层：页面/内容 (Page)（2026-10-16 扁平化：原 Lesson → Page 合并）
model Page {
  id          String    @id @default(uuid())
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Portal lesson.id（2026-10-22 新增）：标题同步的稳定匹配键；此前同步的页面可为空
  externalId  String?
  title       String // 原 Lesson 标题（md 文件标题）
  contentMd   String    @db.Text // 合并后的 Markdown：各原 Page 以 `# {Page标题}` 为 H1 拼接（Lesson.title 不入内容）
  sectionTags Json? // H1-H6 级标签映射：{ "h{n}-slug": ["tag1"] }（2026-10-16：移除页面级 tags）
  sortOrder   Int
  syncState   SyncState @default(SYNCED) // 外部源同步状态（§3.2.2）

  @@unique([courseId, externalId])
  @@index([courseId, sortOrder])
}

// 全局 Tag 词库（2026-10-16 方案 B 轻量版：用户输入新 tag 自动沉淀，颜色自动分配）
model Tag {
  id    String @id @default(uuid())
  name  String @unique // tag 名称（唯一）
  color String // 预设语义色或自动分配色
}

// 同步状态枚举
enum SyncState {
  SYNCED // 与外部源一致
  STALE // 本地独有或外部已变更，已失效
}

// ==========================================
// 发布与版本控制
// ==========================================

model Release {
  id            String   @id @default(uuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id])
  versionTag    String // 版本号，格式: "CourseName_YYYYMMDDHHmm"（精确到分钟）
  revisionNotes String   @db.Text // 本次修订的备注
  snapshotData  Json // 完整内容快照: { pages: [{ id, title, contentMd, sectionTags }] }（2026-10-16 扁平化；去 tags）
  createdAt     DateTime @default(now())

  // 反向关联：该 Release 对应的 AI 配置（2026-10-20 按 Release 一份）
  aiConfigs CourseAiConfig[]
  // 反向关联：该 Release 的知识库向量分块（RAG，2026-10-26 新增）
  knowledgeChunks KnowledgeChunk[]

  @@index([courseId, createdAt])
}

// ==========================================
// RAG 知识库向量分块（2026-10-26 新增）
// 发布 Release 时异步分块 + embedding，对话时按向量相似度检索
// ==========================================
model KnowledgeChunk {
  id          String   @id @default(uuid())
  releaseId   String
  release     Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  pageId      String?   // 原 Page ID（追溯用）
  pageTitle   String    // 页面标题（引用展示用）
  heading     String?   // 所属 H1-H6 标题（引用展示用）
  content     String   @db.Text   // 分块纯文本
  embedding   Unsupported("vector(1536)")  // pgvector 1536 维（text-embedding-3-small）
  sortOrder   Int       // 页面内顺序
  tokenCount  Int       // token 估算（上下文预算用）
  createdAt   DateTime  @default(now())

  @@index([releaseId])
  @@index([releaseId, sortOrder])
}

// ==========================================
// AI Tutor 配置模块
// ==========================================

// AI 提示词模板库（预设两套模式）
model PromptTemplate {
  id           String   @id @default(uuid())
  mode         String // 枚举: "LECTURE" | "SOCRATIC" | "ASSESSMENT"
  systemPrompt String   @db.Text // 系统提示词
  welcomeMsg   String   @db.Text // 欢迎语
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 反向关联：被哪些课程引用
  // 注：CourseAiConfig 存在多条指向本模型的关系（Lecture/Socratic/Assessment），
  // Prisma 要求多关系必须命名消歧，故拆分为多个反向列表字段（不影响数据库列结构）
  lectureConfigs    CourseAiConfig[] @relation("LectureTemplate")
  socraticConfigs   CourseAiConfig[] @relation("SocraticTemplate")
  assessmentConfigs CourseAiConfig[] @relation("AssessmentTemplate")
}

// 课程 + 发布版本 专属的 AI 配置（2026-10-20 改拍：由「每课程一份」→「每个 Release 一份」）
// 2026-10-27 调整：System Prompt 按模式分开（Lecture/Socratic/Assessment），
//   Welcome Message 与 LLM Model 统一为课程级共享列（不随模式切换）。
model CourseAiConfig {
  id        String  @id @default(uuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  releaseId String
  release   Release @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  // 引用基础模板（三条关系分别命名以消歧）
  lectureModeId      String?
  socraticModeId     String?
  assessmentModeId   String?
  lectureTemplate    PromptTemplate? @relation("LectureTemplate", fields: [lectureModeId], references: [id])
  socraticTemplate   PromptTemplate? @relation("SocraticTemplate", fields: [socraticModeId], references: [id])
  assessmentTemplate PromptTemplate? @relation("AssessmentTemplate", fields: [assessmentModeId], references: [id])

  // 主提示词（讲授/苏格拉底共享，置于拼接最前端；Assessment 不参与）
  // 2026-10-29 新增 mainSystemPrompt，用于承载不可协商的硬约束（身份/域界/拒答/注入防护/优先级）
  mainSystemPrompt String? @db.Text

  // 各模式自定义 System Prompt（按模式分开，可选；有值即优先于该模式模板）
  // 2026-10-27 新增 assessmentSystemPrompt；welcome 与 model 统一为共享列
  lectureSystemPrompt    String? @db.Text
  socraticSystemPrompt   String? @db.Text
  assessmentSystemPrompt String? @db.Text

  // 统一 Welcome Message（不再按模式分开）
  welcomeMsg String? @db.Text

  // LLM 配置（llmProvider / llmBaseUrl / apiKey / model 均课程级共享；model null 回退 AI_AVAILABLE_MODELS[0]）
  llmProvider String // 如: "openrouter"
  model       String?
  llmBaseUrl  String? // 可选的自定义 Base URL
  apiKey      String? // 加密存储

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 每个 Release 至多一份配置（2026-10-20 改拍；原 `courseId @unique` 已移除）
  @@unique([courseId, releaseId])
}

// 注：课程级 Online 开关已移至 Course.aiTutorOnline（2026-10-20）；无该 Release 的配置行时按模板默认值运行。

// AI 对话记录（后台调试用）
model AiChatSession {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  messages  Json // 聊天记录: [{role: 'user'|'ai', content: string, createdAt: ISOString}]
  mode      String // 当前对话使用的模式: "LECTURE" | "SOCRATIC"
  createdAt DateTime @default(now())

  @@index([courseId, createdAt])
}

// AI 限流计数（2026-10-24）：多个 Agent 实例共用，见 src/ai/rate-limit.service.ts
model AiRateLimitHit {
  id    BigInt   @id @default(autoincrement())
  key   String
  hitAt DateTime @default(now()) @map("hit_at") @db.Timestamptz(6)

  @@index([key, hitAt])
  @@map("ai_rate_limit_hits")
}

// ==========================================
// BackOffice 员工身份（PRD v1.1 §3、§11；表结构见 migration 20261023150000_backoffice_employees）
// 业务读写走 src/backoffice/repositories 的原生 SQL（触发器与条件更新），这里只为 Prisma 声明表结构。
// ==========================================

model Employee {
  employeeId        String    @id @default(dbgenerated("gen_random_uuid()")) @map("employee_id") @db.Uuid
  loginEmail        String    @unique @map("login_email")
  role              String
  accountStatus     String    @default("ACTIVE") @map("account_status")
  emailVerification String    @default("PENDING_VERIFICATION") @map("email_verification")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordHash      String?   @map("password_hash")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  isBootstrapAdmin  Boolean   @default(false) @map("is_bootstrap_admin")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  sessions     EmployeeSession[]
  tokens       VerificationToken[]
  preferences  EmployeeUiPreference?
  actorEvents  AuditEvent[]          @relation("AuditActor")
  targetEvents AuditEvent[]          @relation("AuditTarget")

  @@index([role], map: "employees_role_idx")
  @@index([accountStatus, emailVerification], map: "employees_status_idx")
  @@map("employees")
}

model EmployeeSession {
  sessionId  String    @id @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)

  @@map("employee_sessions")
}

model VerificationToken {
  tokenId    String    @id @default(dbgenerated("gen_random_uuid()")) @map("token_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  purpose    String
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId, purpose], map: "verification_tokens_employee_idx")
  @@map("verification_tokens")
}

model AuditEvent {
  eventId          BigInt   @id @default(autoincrement()) @map("event_id")
  eventName        String   @map("event_name")
  actorEmployeeId  String?  @map("actor_employee_id") @db.Uuid
  targetEmployeeId String?  @map("target_employee_id") @db.Uuid
  action           String
  oldValue         String?  @map("old_value")
  newValue         String?  @map("new_value")
  result           String
  ipAddress        String?  @map("ip_address")
  requestId        String?  @map("request_id")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor  Employee? @relation("AuditActor", fields: [actorEmployeeId], references: [employeeId], onDelete: SetNull, onUpdate: NoAction)
  target Employee? @relation("AuditTarget", fields: [targetEmployeeId], references: [employeeId], onDelete: SetNull, onUpdate: NoAction)

  @@index([targetEmployeeId, createdAt(sort: Desc)], map: "audit_events_target_idx")
  @@index([eventName, createdAt(sort: Desc)], map: "audit_events_name_idx")
  @@map("audit_events")
}

model EmployeeUiPreference {
  employeeId   String   @id @map("employee_id") @db.Uuid
  locale       String   @default("en-GB")
  sidebarState String   @default("expanded") @map("sidebar_state")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  employee Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade, onUpdate: NoAction)

  @@map("employee_ui_preferences")
}

model BackofficeSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("backoffice_settings")
}

// ==========================================
// Commerce Course（v2，2026-10-26 新增；见 docs/Course_Module_Import_Export_Design.md §14）
// 商品课程：课程 → 课时 两层（无章节），多语言/展品/学习点/测试/试用/版本/导入导出。
// ==========================================

enum CourseLifecycleStatus {
  WORKING
  IN_UAT
  APPROVED
  LIVE
}

enum CourseLiveStatus {
  ONLINE
  HIDDEN
  OFFLINE
}

enum LearningMode {
  VIDEO_ONLY
  TEXT_ONLY
  VIDEO_AND_TEXT
}

enum ExhibitType {
  IMAGE
  VIDEO
  MODEL3D
}

enum ReadingType {
  BOOK
  ARTICLE
  PAPER
}

enum TrialRowStatus {
  READY
  RE_CONFIRM
  LOCKED
}

enum LearningPointSource {
  VIDEO
  TEXT
}

enum CourseMediaKind {
  IMAGE
  VIDEO
  PDF
  AUDIO
  MODEL3D
}

enum CatalogueStatus {
  ACTIVE
  ARCHIVED
}

enum CoursePackageJobKind {
  IMPORT
  EXPORT
}

enum CoursePackageJobStatus {
  UPLOADING
  VALIDATING
  AWAITING_CONFIRM
  IMPORTING
  EXPORTING
  READY
  FAILED
  CANCELLED
}

model CommerceCourse {
  id                     String                @id @default(uuid())
  code                   String                @unique
  slug                   String                @unique
  categoryId             String?
  category               CourseCatalogueEntry? @relation("CourseCategory", fields: [categoryId], references: [id])
  subjectId              String?
  subject                CourseCatalogueEntry? @relation("CourseSubject", fields: [subjectId], references: [id])
  learningMode           LearningMode
  defaultContentLanguage String                @default("en-GB")
  learningLanguages      Json
  coverAssetId           String?                @unique
  cover                  CourseMediaAsset?     @relation("CourseCover", fields: [coverAssetId], references: [id])

  lifecycleStatus        CourseLifecycleStatus @default(WORKING)
  liveStatus             CourseLiveStatus      @default(HIDDEN)
  liveVersionId          String?
  currentUatVersionId    String?
  approvedAt             DateTime?
  approvedBy             String?
  lastUatPublishedAt     DateTime?
  archivedAt             DateTime?

  // v1 兼容 / 迁移过渡
  subtitle               String?
  level                  String?
  tags                   Json?
  referencePrice         Int?
  discount               Int?
  legacyCategory         String?
  legacyAuthorIds        Json?

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  localizations CourseLocalization[]
  lessons       Lesson[]
  versions      CourseVersion[]
  media         CourseMediaAsset[]            @relation("CourseMedia")
  trialRows     TrialSetting[]
  authors       CommerceCourseAuthor[]
  plans         CoursePlan[]
  ksCourse      Course?

  @@index([lifecycleStatus, updatedAt])
  @@index([liveStatus])
  @@index([categoryId])
}

model CourseLocalization {
  id               String         @id @default(uuid())
  courseId         String
  course           CommerceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  language         String
  title            String
  shortDescription String?
  overview         String?        @db.Text
  whatYouLearn     Json?
  provides         Json?

  @@unique([courseId, language])
}

model Lesson {
  id                 String         @id @default(uuid())
  courseId           String
  course             CommerceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  code               String
  sortOrder          Int
  legacySectionId    String?
  legacySectionTitle String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  localizations   LessonLocalization[]
  exhibits        Exhibit[]
  readings        RecommendedReading[]
  questions       KnowledgeQuestion[]
  applicationTest ApplicationTest?
  learningPoints  LearningPoint[]
  triggers        ExhibitTrigger[]

  @@unique([courseId, code])
  @@index([courseId, sortOrder])
}

model LessonLocalization {
  id                   String           @id @default(uuid())
  lessonId             String
  lesson               Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language             String
  title                String
  description          String?
  videoAssetId         String?
  video                CourseMediaAsset? @relation("LessonVideo", fields: [videoAssetId], references: [id])
  videoDurationSeconds Int?
  textHtml             String?          @db.Text
  textLearningPoints   Json?
  legacyContents       Json?

  @@unique([lessonId, language])
}

model Exhibit {
  id               String           @id @default(uuid())
  lessonId         String
  lesson           Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  code             String
  type             ExhibitType
  mediaAssetId     String?
  media            CourseMediaAsset? @relation("ExhibitMedia", fields: [mediaAssetId], references: [id])
  thumbnailAssetId String?
  thumbnail        CourseMediaAsset? @relation("ExhibitThumbnail", fields: [thumbnailAssetId], references: [id])
  sourceText       String?
  localized        Json
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([lessonId, code])
}

model LearningPoint {
  id            String              @id @default(uuid())
  lessonId      String
  lesson        Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language      String
  code          String
  title         String
  source        LearningPointSource
  timeSeconds   Int?
  anchorHeading String?
  sortOrder     Int

  @@unique([lessonId, language, code])
}

model ExhibitTrigger {
  id          String @id @default(uuid())
  lessonId    String
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  exhibitId   String
  language    String
  timeSeconds Int

  @@unique([lessonId, exhibitId, language])
}

model RecommendedReading {
  id             String      @id @default(uuid())
  lessonId       String
  lesson         Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  language       String
  type           ReadingType
  title          String
  author         String?
  whyRecommended String?     @db.Text
  sortOrder      Int

  @@index([lessonId, language, sortOrder])
}

model KnowledgeQuestion {
  id              String  @id @default(uuid())
  lessonId        String
  lesson          Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  code            String
  question        String  @db.Text
  referenceAnswer String? @db.Text
  sortOrder       Int
  enabled         Boolean @default(true)

  @@unique([lessonId, code])
}

model ApplicationTest {
  id              String  @id @default(uuid())
  lessonId        String  @unique
  lesson          Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  scenario        String  @db.Text
  referenceAnswer String? @db.Text
  enabled         Boolean @default(true)
}

model TrialSetting {
  id                        String         @id @default(uuid())
  courseId                  String
  course                    CommerceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId                  String
  videoCutoffSeconds        Int?
  textCutoffLearningPointId String?
  status                    TrialRowStatus @default(LOCKED)

  @@unique([courseId, lessonId])
}

model CourseVersion {
  id              String         @id @default(uuid())
  courseId        String
  course          CommerceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versionNo       Int
  snapshotData    Json
  sourceVersionId String?
  wentLiveAt      DateTime?
  createdBy       String?
  createdAt       DateTime       @default(now())

  @@unique([courseId, versionNo])
  @@index([courseId, wentLiveAt])
}

model CourseMediaAsset {
  id           String          @id @default(uuid())
  courseId     String
  course       CommerceCourse  @relation("CourseMedia", fields: [courseId], references: [id], onDelete: Cascade)
  kind         CourseMediaKind
  originalName String
  mimeType     String
  extension    String
  size         Int
  storageKey   String          @unique
  checksum     String?
  createdBy    String?
  createdAt    DateTime        @default(now())

  coverFor         CommerceCourse?    @relation("CourseCover")
  exhibitMedia     Exhibit[]          @relation("ExhibitMedia")
  exhibitThumbnail Exhibit[]          @relation("ExhibitThumbnail")
  lessonVideos     LessonLocalization[] @relation("LessonVideo")

  @@index([courseId, kind])
}

model CourseCatalogueEntry {
  id          String                 @id @default(uuid())
  name        String
  description String                 @default("")
  parentId    String?
  parent      CourseCatalogueEntry?  @relation("CatalogueParent", fields: [parentId], references: [id])
  children    CourseCatalogueEntry[] @relation("CatalogueParent")
  status      CatalogueStatus        @default(ACTIVE)
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  coursesAsCategory CommerceCourse[] @relation("CourseCategory")
  coursesAsSubject  CommerceCourse[] @relation("CourseSubject")

  @@unique([parentId, name])
  @@index([parentId, sortOrder])
}

model CoursePlan {
  id              String          @id
  courseId        String?
  course          CommerceCourse? @relation(fields: [courseId], references: [id])
  name            String
  scope           String
  scopeId         String
  termMonths      Int
  device          String
  amountMinor     Int
  currency        String          @default("usd")
  stripeLookupKey String?
  aiPoints        Int             @default(0)
  trialEligible   Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([scope, scopeId])
}

model CommerceCourseAuthor {
  courseId   String
  course     CommerceCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeId String         @db.Uuid
  createdAt  DateTime       @default(now())

  @@id([courseId, employeeId])
  @@index([employeeId])
}

model CourseAuthoringActivity {
  id              BigInt   @id @default(autoincrement())
  courseId        String?
  actorEmployeeId String?  @db.Uuid
  action          String
  detail          Json?
  requestId       String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  @@index([courseId, createdAt(sort: Desc)])
}

model PopularCourseEntry {
  id        String         @id @default(uuid())
  courseId  String         @unique
  sortOrder Int
  createdAt DateTime       @default(now())

  @@index([sortOrder])
}

model DiscoveryBanner {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(false)
  courseId  String?
  localized Json?
  updatedAt DateTime @updatedAt
}

model CoursePackageJob {
  id              String                 @id @default(uuid())
  kind            CoursePackageJobKind
  status          CoursePackageJobStatus @default(UPLOADING)
  courseId        String?
  actorEmployeeId String?                @db.Uuid
  idempotencyKey  String?                @unique
  packageHash     String?
  sourceFileName  String?
  bytesTotal      Int?
  bytesReceived   Int?                   @default(0)
  stage           String?
  progress        Int?                   @default(0)
  manifest        Json?
  report          Json?
  conflicts       Json?
  storageKey      String?
  error           String?
  lockedBy        String?
  lockedAt        DateTime?
  heartbeatAt     DateTime?
  attempts        Int                    @default(0)
  cancelRequested Boolean                @default(false)
  nextAttemptAt   DateTime?
  requestId       String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([kind, status, createdAt])
  @@index([actorEmployeeId, createdAt])
}

