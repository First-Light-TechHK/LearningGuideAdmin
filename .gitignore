# OS
.DS_Store
Thumbs.db
desktop.ini
# macOS 解压/复制残留（AppleDouble），每个文件一份，随素材一起生成
._*

# IDE
.vs/
.idea/
*.swp
# 多根工作区（含本机绝对路径，不入库）
*.code-workspace

# 密钥与环境（.env.example 除外）
.env
.env.*
!.env.example

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo

# Next.js（backoffice/）
.next/
out/
next-env.d.ts

# 日志与临时文件
*.log
*.tmp

# AI/脚本的本地临时产物目录（约定写入仓库内，避免越出工作区）
.tmp/

# AI 对话运行日志（§4.4.2 第 7 步，本地运行产物）
app-logs/

# 本地测试上传文件（不上库）
test_files/

# Figma 访问令牌（本地导出设计图用，绝不入库）
.figma-token

# 设计走查用的临时页面快照
docs/design/figma/preview/

# Helpdesk 推荐评测报告（npm run eval:helpdesk 的缺省输出）
helpdesk-eval-report.*

# Figma 整页几何缓存（体积大，可由 scripts/figma-icons.mjs 重新拉取）
docs/design/figma/course-management/*.geometry.json

# 课程媒体与原始素材（大文件，超过 GitHub 100MB 单文件限制，不入库；媒体存放于 server/storage）
server/storage/
docs/*.zip
docs/*.mp4
docs/modeling-life/
docs/Modeling Life Data/
docs/Modeling life数据-small/
# 运营直接解压到 docs/ 的课程素材包（含同名副本、下载产生的 “(1)” 文件）
docs/Modeling*/
docs/__MACOSX/
docs/*(1).*

# 本地从 PRD 文档提取的文本（一次性工作产物）
prd_extracted.txt

# Cursor 本地会话/缓存（机器相关，不入库）
.cursor/
